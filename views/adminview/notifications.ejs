<div class="loader"></div>
<div id="app">
  <div class="main-wrapper main-wrapper-1">
    <div class="navbar-bg"></div>

    <%- include('../partials/headerAdmin.ejs') %>
    <%- include('../partials/sideMenuAdmin.ejs') %>

    <div class="main-content">
      <section class="section">
        <div class="section-header">
          <h1>Notifications</h1>
          <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="/admin/main">Dashboard</a></div>
            <div class="breadcrumb-item">Notifications</div>
          </div>
        </div>

        <div class="section-body">

          <% if (locals.success_msg && success_msg.length) { %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <%= success_msg[0] %>
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
          </div>
          <% } %>
          <% if (locals.error_msg && error_msg.length) { %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <%= error_msg[0] %>
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
          </div>
          <% } %>
          <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger"><strong>Error:</strong> <%= error %></div>
          <% } %>

          <!-- Tab nav -->
          <ul class="nav nav-tabs mb-3" id="notifTabs">
            <li class="nav-item">
              <a class="nav-link <%= tab === 'messages' ? 'active' : '' %>"
                href="/admin/push-notifications?tab=messages">Messages</a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= tab === 'send' ? 'active' : '' %>"
                href="/admin/push-notifications?tab=send">Send</a>
            </li>
          </ul>

          <!-- ══════════════ MESSAGES TAB ══════════════ -->
          <% if (tab === 'messages') { %>

          <!-- Add message card -->
          <div class="card">
            <div class="card-header"><h4>Add Message</h4></div>
            <div class="card-body">
              <form method="POST" action="/admin/push-notifications/messages">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-group">
                  <label>Title</label>
                  <input type="text" name="title" class="form-control" required placeholder="Notification title">
                </div>
                <div class="form-group">
                  <label>Body</label>
                  <textarea name="body" class="form-control" rows="3" required placeholder="Notification body"></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Save Message</button>
              </form>
            </div>
          </div>

          <!-- Saved messages list -->
          <div class="card">
            <div class="card-header"><h4>Saved Messages</h4></div>
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                  <thead>
                    <tr>
                      <th style="width:200px;">Title</th>
                      <th>Body</th>
                      <th style="width:160px;">Created</th>
                      <th style="width:80px;"></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (messages && messages.length) { %>
                    <% messages.forEach(m => { %>
                    <tr>
                      <td><strong><%= m.title %></strong></td>
                      <td><%= m.body %></td>
                      <td>
                        <small><%= new Date(m.createdAt).toLocaleString('en-GB', { day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }) %></small>
                      </td>
                      <td>
                        <form method="POST" action="/admin/push-notifications/messages/<%= m._id %>?_method=DELETE"
                          onsubmit="return confirm('Delete this message?')">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" class="btn btn-sm btn-danger">
                            <i class="fas fa-trash"></i>
                          </button>
                        </form>
                      </td>
                    </tr>
                    <% }) %>
                    <% } else { %>
                    <tr><td colspan="4" class="text-center py-4 text-muted">No messages saved yet.</td></tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <% } %>

          <!-- ══════════════ SEND TAB ══════════════ -->
          <% if (tab === 'send') { %>

          <div class="row">

            <!-- Per-user send -->
            <div class="col-12 col-lg-6">
              <div class="card">
                <div class="card-header"><h4>Send to User</h4></div>
                <div class="card-body">

                  <!-- Sub-tabs: Registered Devices / All Users -->
                  <ul class="nav nav-tabs nav-tabs-sm mb-3" id="sendUserTabs">
                    <li class="nav-item">
                      <a class="nav-link active" id="tabDevicesLink" href="#"
                        onclick="switchSendTab('devices'); return false;">Registered Devices</a>
                    </li>
                    <li class="nav-item">
                      <a class="nav-link" id="tabAllUsersLink" href="#"
                        onclick="switchSendTab('allUsers'); return false;">All Users</a>
                    </li>
                  </ul>

                  <!-- Registered Devices section -->
                  <div id="sendDevicesSection">
                    <% if (!registeredUsers || !registeredUsers.length) { %>
                    <p class="text-muted">No registered devices yet.</p>
                    <% } else { %>
                    <form id="sendUserForm">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <div class="form-group">
                        <label>User</label>
                        <div class="user-search-wrap" style="position:relative;">
                          <input type="text" class="form-control user-search-input"
                            placeholder="Type name or email to search…" autocomplete="off">
                          <input type="hidden" name="userId">
                          <div class="user-search-dropdown"></div>
                        </div>
                      </div>
                      <%- include('../partials/notificationMessageSelect.ejs') %>
                      <button type="submit" class="btn btn-primary btn-block" id="sendUserBtn">Send</button>
                    </form>
                    <% } %>
                  </div>

                  <!-- All Users section -->
                  <div id="sendAllUsersSection" style="display:none;">
                    <% if (!allUsers || !allUsers.length) { %>
                    <p class="text-muted">No users found.</p>
                    <% } else { %>
                    <form id="sendAllUsersForm">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <div class="form-group">
                        <label>User</label>
                        <div class="user-search-wrap" style="position:relative;">
                          <input type="text" class="form-search-input form-control user-search-input"
                            placeholder="Type name or email to search…" autocomplete="off">
                          <input type="hidden" name="userId">
                          <div class="user-search-dropdown"></div>
                        </div>
                      </div>
                      <%- include('../partials/notificationMessageSelect.ejs') %>
                      <button type="submit" class="btn btn-primary btn-block" id="sendAllUsersBtn">Send</button>
                    </form>
                    <% } %>
                  </div>

                </div>
              </div>
            </div>

            <!-- Broadcast -->
            <div class="col-12 col-lg-6">
              <div class="card">
                <div class="card-header">
                  <h4>Broadcast</h4>
                  <small class="text-muted ml-2">Check users below for selective broadcast, or leave unchecked to send to all.</small>
                </div>
                <div class="card-body">
                  <form id="broadcastForm">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <%- include('../partials/notificationMessageSelect.ejs') %>

                    <% if (registeredUsers && registeredUsers.length) { %>
                    <div class="form-group">
                      <label>Select users (optional — leave blank for all)</label>
                      <div style="max-height:200px;overflow-y:auto;border:1px solid #e4e6fc;border-radius:4px;padding:8px;">
                        <% registeredUsers.forEach(ru => { %>
                        <div class="custom-control custom-checkbox mb-1">
                          <input type="checkbox" class="custom-control-input" name="userIds"
                            value="<%= ru.user._id %>" id="user_<%= ru.user._id %>">
                          <label class="custom-control-label" for="user_<%= ru.user._id %>">
                            <%= ru.user.firstname %> <%= ru.user.lastname %> (<%= ru.user.email %>)
                          </label>
                        </div>
                        <% }) %>
                      </div>
                    </div>
                    <% } else { %>
                    <p class="text-muted">No registered devices yet. Broadcast will still reach all users via in-app notifications.</p>
                    <% } %>

                    <button type="submit" class="btn btn-warning btn-block" id="broadcastBtn">Broadcast</button>
                  </form>
                </div>
              </div>
            </div>

          </div>

          <% } %>

        </div><!-- /section-body -->
      </section>
    </div>

    <%- include('../partials/footerAdmin.ejs') %>
  </div>
</div>
<script src="/admin/assets/js/app.min.js"></script>
<script src="/admin/assets/js/scripts.js"></script>
<style>
  .user-search-dropdown {
    display: none;
    position: absolute;
    left: 0; right: 0; top: 100%;
    z-index: 1050;
    background: #fff;
    border: 1px solid #dee2e6;
    border-radius: 4px;
    max-height: 210px;
    overflow-y: auto;
    box-shadow: 0 4px 14px rgba(0,0,0,0.10);
    margin-top: 2px;
  }
  .usr-opt {
    padding: 8px 12px;
    cursor: pointer;
    font-size: 13px;
    border-bottom: 1px solid #f5f5f5;
    line-height: 1.35;
  }
  .usr-opt:hover { background: #f0f4ff; }
  .usr-opt:last-child { border-bottom: none; }
  .user-search-input.is-invalid { border-color: #dc3545 !important; }
</style>
<script>
  // ── User search/autocomplete picker ──────────────────────────
  function escH(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function initUserSearch(wrapEl, users) {
    var input    = wrapEl.querySelector('.user-search-input');
    var hidden   = wrapEl.querySelector('input[name="userId"]');
    var dropdown = wrapEl.querySelector('.user-search-dropdown');

    function render(query) {
      var q = query.trim().toLowerCase();
      var matches = users.filter(function(u) {
        return !q || u.label.toLowerCase().indexOf(q) !== -1;
      }).slice(0, 12);

      if (!matches.length) {
        dropdown.innerHTML = '<div style="padding:9px 12px;color:#9ca3af;font-size:13px;">No matches found</div>';
      } else {
        dropdown.innerHTML = matches.map(function(u) {
          return '<div class="usr-opt" data-id="' + escH(u.id) + '">' + escH(u.label) + '</div>';
        }).join('');
        dropdown.querySelectorAll('.usr-opt').forEach(function(item) {
          item.addEventListener('mousedown', function(e) {
            e.preventDefault();
            hidden.value = item.dataset.id;
            input.value  = item.textContent.trim();
            input.classList.remove('is-invalid');
            dropdown.style.display = 'none';
          });
        });
      }
      dropdown.style.display = '';
    }

    input.addEventListener('input',  function() { hidden.value = ''; render(input.value); });
    input.addEventListener('focus',  function() { render(input.value); });
    input.addEventListener('blur',   function() { setTimeout(function() { dropdown.style.display = 'none'; }, 200); });
  }

  // Embed user data
  var registeredUsersData = <%- JSON.stringify((registeredUsers || []).map(function(ru) {
    return { id: String(ru.user._id), label: ru.user.firstname + ' ' + ru.user.lastname + ' — ' + ru.user.email };
  })) %>;
  var allUsersData = <%- JSON.stringify((allUsers || []).map(function(u) {
    return { id: String(u._id), label: u.firstname + ' ' + u.lastname + ' — ' + u.email };
  })) %>;

  // Initialise pickers
  var devicesWrap  = document.querySelector('#sendUserForm .user-search-wrap');
  var allUsersWrap = document.querySelector('#sendAllUsersForm .user-search-wrap');
  if (devicesWrap)  initUserSearch(devicesWrap,  registeredUsersData);
  if (allUsersWrap) initUserSearch(allUsersWrap, allUsersData);

  // ── Toggle custom message fields ──────────────────────────────
  document.querySelectorAll('.msg-select').forEach(function(sel) {
    var wrap = sel.closest('form').querySelector('.custom-msg-wrap');
    function toggle() {
      if (sel.value === 'custom') {
        wrap.style.display = '';
        wrap.querySelectorAll('input,textarea').forEach(function(el) { el.required = true; });
      } else {
        wrap.style.display = 'none';
        wrap.querySelectorAll('input,textarea').forEach(function(el) { el.required = false; });
      }
    }
    sel.addEventListener('change', toggle);
    toggle();
  });

  // ── Sub-tab switcher ──────────────────────────────────────────
  function switchSendTab(tab) {
    var devicesSection  = document.getElementById('sendDevicesSection');
    var allUsersSection = document.getElementById('sendAllUsersSection');
    var devicesLink     = document.getElementById('tabDevicesLink');
    var allUsersLink    = document.getElementById('tabAllUsersLink');
    if (tab === 'devices') {
      if (devicesSection)  devicesSection.style.display  = '';
      if (allUsersSection) allUsersSection.style.display = 'none';
      if (devicesLink)     devicesLink.classList.add('active');
      if (allUsersLink)    allUsersLink.classList.remove('active');
    } else {
      if (devicesSection)  devicesSection.style.display  = 'none';
      if (allUsersSection) allUsersSection.style.display = '';
      if (devicesLink)     devicesLink.classList.remove('active');
      if (allUsersLink)    allUsersLink.classList.add('active');
    }
  }

  // ── Send form submit helper ───────────────────────────────────
  async function submitSendForm(form, btnId) {
    var btn = document.getElementById(btnId);
    if (!btn) return;

    var hiddenId = form.querySelector('input[name="userId"]');
    if (hiddenId && !hiddenId.value) {
      var searchInput = form.querySelector('.user-search-input');
      if (searchInput) { searchInput.classList.add('is-invalid'); searchInput.focus(); }
      return;
    }

    btn.disabled = true;
    var orig = btn.textContent;
    btn.textContent = 'Sending…';
    try {
      var formData = new FormData(form);
      var params   = new URLSearchParams(formData).toString();
      var csrf     = formData.get('_csrf') || '';
      await fetch('/admin/push-notifications/send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': csrf },
        body: params,
      });
    } catch (err) {}
    btn.disabled = false;
    btn.textContent = orig;
  }

  // ── Send to User (Registered Devices) ────────────────────────
  var sendUserForm = document.getElementById('sendUserForm');
  if (sendUserForm) {
    sendUserForm.addEventListener('submit', function(e) {
      e.preventDefault();
      submitSendForm(sendUserForm, 'sendUserBtn');
    });
  }

  // ── Send to User (All Users) ──────────────────────────────────
  var sendAllUsersForm = document.getElementById('sendAllUsersForm');
  if (sendAllUsersForm) {
    sendAllUsersForm.addEventListener('submit', function(e) {
      e.preventDefault();
      submitSendForm(sendAllUsersForm, 'sendAllUsersBtn');
    });
  }

  // ── Broadcast ────────────────────────────────────────────────
  var broadcastForm = document.getElementById('broadcastForm');
  if (broadcastForm) {
    broadcastForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      var btn = document.getElementById('broadcastBtn');
      btn.disabled = true;
      btn.textContent = 'Sending…';
      try {
        var formData = new FormData(broadcastForm);
        var params   = new URLSearchParams(formData).toString();
        var csrf     = formData.get('_csrf') || '';
        await fetch('/admin/push-notifications/broadcast', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': csrf },
          body: params,
        });
      } catch (err) {}
      btn.disabled = false;
      btn.textContent = 'Broadcast';
    });
  }
</script>
