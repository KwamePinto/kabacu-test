<div class="loader"></div>
<div id="app">
  <div class="main-wrapper main-wrapper-1">
    <div class="navbar-bg"></div>
    <%- include('../../partials/headerAdmin.ejs') %>
    <%- include('../../partials/sideMenuAdmin.ejs') %>

    <div class="main-content">
      <section class="section">
        <div class="section-header">
          <h1>Transactions</h1>
          <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="/admin/main">Dashboard</a></div>
            <div class="breadcrumb-item">Transactions</div>
          </div>
        </div>

        <div class="section-body">

          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger"><strong>Error:</strong> <%- error %></div>
          <% } %>

          <%
            var all        = transactions || [];
            var success    = all.filter(function(t){ return t.status === 'success' && !t.adminCleared; });
            var failed     = all.filter(function(t){ return t.status === 'failed'  && !t.adminCleared; });
            var pending    = all.filter(function(t){ return t.status === 'pending' && !t._isAttention && !t.adminCleared; });
            var attention  = all.filter(function(t){ return t._isAttention && !t.adminCleared; });
            var flagged    = all.filter(function(t){
              return !t.adminCleared && (
                (t.status === 'failed' && t.apiResponse && t.apiResponse.status === 'fail' && !t.apiResponse.message && !t.apiResponse.adminDeducted) ||
                t._isAttention ||
                (t._suspicious && t._suspicious.length > 0)
              );
            });
            var cleared    = all.filter(function(t){ return t.adminCleared; });
            var active     = all.filter(function(t){ return !t.adminCleared; });
          %>

          <!-- Summary cards -->
          <div class="row mb-4">
            <div class="col-6 col-md-2">
              <div class="card card-statistic-1">
                <div class="card-icon bg-primary"><i class="fas fa-list"></i></div>
                <div class="card-wrap"><div class="card-header"><h4>All</h4></div><div class="card-body"><%= active.length %></div></div>
              </div>
            </div>
            <div class="col-6 col-md-2">
              <div class="card card-statistic-1">
                <div class="card-icon bg-success"><i class="fas fa-check"></i></div>
                <div class="card-wrap"><div class="card-header"><h4>Success</h4></div><div class="card-body"><%= success.length %></div></div>
              </div>
            </div>
            <div class="col-6 col-md-2">
              <div class="card card-statistic-1">
                <div class="card-icon bg-danger"><i class="fas fa-times"></i></div>
                <div class="card-wrap"><div class="card-header"><h4>Failed</h4></div><div class="card-body"><%= failed.length %></div></div>
              </div>
            </div>
            <div class="col-6 col-md-2">
              <div class="card card-statistic-1">
                <div class="card-icon bg-warning"><i class="fas fa-clock"></i></div>
                <div class="card-wrap"><div class="card-header"><h4>Pending</h4></div><div class="card-body"><%= pending.length %></div></div>
              </div>
            </div>
            <div class="col-6 col-md-2">
              <div class="card card-statistic-1">
                <div class="card-icon bg-warning" style="background:#f97316!important;"><i class="fas fa-exclamation-circle"></i></div>
                <div class="card-wrap"><div class="card-header"><h4>Attention</h4></div><div class="card-body"><%= attention.length %></div></div>
              </div>
            </div>
            <div class="col-6 col-md-2">
              <div class="card card-statistic-1">
                <div class="card-icon bg-danger"><i class="fas fa-flag"></i></div>
                <div class="card-wrap"><div class="card-header"><h4>Flagged</h4></div><div class="card-body"><%= flagged.length %></div></div>
              </div>
            </div>
          </div>

          <!-- Tabs -->
          <ul class="nav nav-tabs mb-0" id="txTabs" role="tablist">
            <li class="nav-item"><a class="nav-link active" data-toggle="tab" href="#tab-all">All <span class="badge badge-secondary ml-1"><%= active.length %></span></a></li>
            <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#tab-success">Success <span class="badge badge-success ml-1"><%= success.length %></span></a></li>
            <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#tab-failed">Failed <span class="badge badge-danger ml-1"><%= failed.length %></span></a></li>
            <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#tab-pending">Pending <span class="badge badge-warning ml-1"><%= pending.length %></span></a></li>
            <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#tab-attention" style="color:#f97316;">Attention <span class="badge ml-1" style="background:#f97316;color:#fff;"><%= attention.length %></span></a></li>
            <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#tab-flagged">Flagged <span class="badge badge-danger ml-1"><%= flagged.length %></span></a></li>
            <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#tab-cleared">Cleared <span class="badge badge-secondary ml-1"><%= cleared.length %></span></a></li>
          </ul>

          <div class="tab-content">

            <!-- ── ALL ── -->
            <div class="tab-pane fade show active" id="tab-all">
              <%- include('../../partials/txTable.ejs', { rows: active, showActions: true }) %>
            </div>

            <!-- ── SUCCESS ── -->
            <div class="tab-pane fade" id="tab-success">
              <%- include('../../partials/txTable.ejs', { rows: success, showActions: true }) %>
            </div>

            <!-- ── FAILED ── -->
            <div class="tab-pane fade" id="tab-failed">
              <%- include('../../partials/txTable.ejs', { rows: failed, showActions: true }) %>
            </div>

            <!-- ── PENDING ── -->
            <div class="tab-pane fade" id="tab-pending">
              <%- include('../../partials/txTable.ejs', { rows: pending, showActions: true }) %>
            </div>

            <!-- ── ATTENTION ── -->
            <div class="tab-pane fade" id="tab-attention">
              <div class="alert alert-warning mt-3">
                <strong>Attention required.</strong> These transactions received no response from OurDataStore (timeout, network error, etc.).
                Verify in the OurDataStore dashboard then use the action buttons to mark as delivered or refund the user.
              </div>
              <%- include('../../partials/txTable.ejs', { rows: attention, showActions: true }) %>
            </div>

            <!-- ── FLAGGED ── -->
            <div class="tab-pane fade" id="tab-flagged">
              <div class="alert alert-danger mt-3">
                <strong>Suspicious transactions.</strong> These match one or more flagging rules — check the Reason column before taking action.
              </div>
              <%- include('../../partials/txTable.ejs', { rows: flagged, showActions: true, showReasons: true }) %>
            </div>

            <!-- ── CLEARED ── -->
            <div class="tab-pane fade" id="tab-cleared">
              <div class="alert alert-secondary mt-3">
                These transactions have been manually reviewed and cleared by admin.
              </div>
              <%- include('../../partials/txTable.ejs', { rows: cleared, showActions: false }) %>
            </div>

          </div><!-- /tab-content -->

        </div>
      </section>
    </div>

    <%- include('../../partials/footerAdmin.ejs') %>
  </div>
</div>
<script src="/admin/assets/js/app.min.js"></script>
<script src="/admin/assets/js/scripts.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
var _csrf = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';

async function adminPost(url, body) {
  const r = await fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': _csrf },
    body: JSON.stringify(body),
  });
  return r.json();
}

function removeRow(id) {
  var row = document.getElementById('txrow-' + id);
  if (row) { row.style.opacity = '0.3'; row.style.pointerEvents = 'none'; }
}

// ── Resolve attention ────────────────────────────────────────────────────────
document.querySelectorAll('.btn-resolve-attention').forEach(function(btn) {
  btn.addEventListener('click', async function() {
    var id     = this.dataset.id;
    var action = this.dataset.action;
    var amount = this.dataset.amount;
    var user   = this.dataset.user;
    var isSuccess = action === 'success';

    var confirm = await Swal.fire({
      icon: isSuccess ? 'question' : 'warning',
      title: isSuccess ? 'Mark as Delivered?' : 'Refund User?',
      html: isSuccess
        ? `Confirm OurDataStore delivered data for <strong>${user}</strong> (₦${Number(amount).toLocaleString()}). Wallet charge stands.`
        : `Refund <strong>₦${Number(amount).toLocaleString()}</strong> to <strong>${user}</strong>? Only if data was NOT delivered.`,
      showCancelButton: true,
      confirmButtonText: isSuccess ? 'Yes, Delivered' : 'Yes, Refund',
      confirmButtonColor: isSuccess ? '#47c363' : '#6c757d',
    });
    if (!confirm.isConfirmed) return;
    this.disabled = true; this.textContent = 'Working…';

    try {
      var data = await adminPost('/admin/transactions/resolve-attention', { transactionId: id, action });
      if (data.success) {
        Swal.fire({ icon: 'success', title: 'Done', text: data.message, timer: 2000, showConfirmButton: false });
        removeRow(id);
      } else {
        Swal.fire({ icon: 'error', title: 'Failed', text: data.message });
        this.disabled = false; this.textContent = isSuccess ? 'Mark Delivered' : 'Refund';
      }
    } catch(_) {
      Swal.fire({ icon: 'error', text: 'Something went wrong' });
      this.disabled = false;
    }
  });
});

// ── Force refund (success → refunded) ────────────────────────────────────────
document.querySelectorAll('.btn-force-refund').forEach(function(btn) {
  btn.addEventListener('click', async function() {
    var id     = this.dataset.id;
    var amount = this.dataset.amount;
    var user   = this.dataset.user;

    var confirm = await Swal.fire({
      icon: 'warning',
      title: 'Force Refund?',
      html: `<strong>Warning:</strong> This will reverse a <em>successful</em> transaction and refund ₦${Number(amount).toLocaleString()} to <strong>${user}</strong>.<br><br>This cannot be undone. Only proceed if you are certain the data was not actually delivered.`,
      showCancelButton: true,
      confirmButtonText: 'Yes, Force Refund',
      confirmButtonColor: '#dc3545',
    });
    if (!confirm.isConfirmed) return;
    this.disabled = true; this.textContent = 'Working…';

    try {
      var data = await adminPost('/admin/transactions/force-refund', { transactionId: id });
      if (data.success) {
        Swal.fire({ icon: 'success', title: 'Refunded', text: data.message, timer: 2500, showConfirmButton: false });
        removeRow(id);
      } else {
        Swal.fire({ icon: 'error', title: 'Failed', text: data.message });
        this.disabled = false; this.textContent = 'Force Refund';
      }
    } catch(_) {
      Swal.fire({ icon: 'error', text: 'Something went wrong' });
      this.disabled = false;
    }
  });
});

// ── Clear / dismiss ───────────────────────────────────────────────────────────
document.querySelectorAll('.btn-clear-tx').forEach(function(btn) {
  btn.addEventListener('click', async function() {
    var id = this.dataset.id;
    this.disabled = true;
    try {
      var data = await adminPost('/admin/transactions/clear', { transactionId: id });
      if (data.success) {
        removeRow(id);
      } else {
        Swal.fire({ icon: 'error', text: data.message });
        this.disabled = false;
      }
    } catch(_) {
      Swal.fire({ icon: 'error', text: 'Something went wrong' });
      this.disabled = false;
    }
  });
});
</script>
