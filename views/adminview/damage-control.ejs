<div class="loader"></div>
<div id="app">
  <div class="main-wrapper main-wrapper-1">
    <div class="navbar-bg"></div>
    <%- include('../partials/headerAdmin.ejs') %>
    <%- include('../partials/sideMenuAdmin.ejs') %>

    <div class="main-content">
      <section class="section">
        <div class="section-header">
          <h1>Damage Control</h1>
          <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="/admin/main">Dashboard</a></div>
            <div class="breadcrumb-item">Damage Control</div>
          </div>
        </div>

        <div class="section-body">

          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger"><strong>Error:</strong> <%- error %></div>
          <% } %>

          <!-- Explainer -->
          <div class="alert alert-warning">
            <strong>What is this?</strong>
            These are wallet payment transactions that failed because our server timed out waiting
            for OurDataStore — but OurDataStore may have already delivered the data to the user's phone.
            The wallet was <strong>refunded</strong> at the time. Use the OurDataStore dashboard to verify
            each entry, then click <strong>Deduct Wallet</strong> for confirmed deliveries.
          </div>

          <!-- Summary cards -->
          <div class="row mb-4">
            <div class="col-6 col-md-3">
              <div class="card card-statistic-1">
                <div class="card-icon bg-danger"><i class="fas fa-exclamation-triangle"></i></div>
                <div class="card-wrap">
                  <div class="card-header"><h4>Suspicious</h4></div>
                  <div class="card-body"><%= rows.length %></div>
                </div>
              </div>
            </div>
            <div class="col-6 col-md-3">
              <div class="card card-statistic-1">
                <div class="card-icon bg-warning"><i class="fas fa-naira-sign"></i></div>
                <div class="card-wrap">
                  <div class="card-header"><h4>Total Exposed</h4></div>
                  <div class="card-body">₦<%= totalAmount.toLocaleString() %></div>
                </div>
              </div>
            </div>
            <div class="col-6 col-md-3">
              <div class="card card-statistic-1">
                <div class="card-icon bg-success"><i class="fas fa-check-circle"></i></div>
                <div class="card-wrap">
                  <div class="card-header"><h4>Already Fixed</h4></div>
                  <div class="card-body"><%= alreadyDeducted %></div>
                </div>
              </div>
            </div>
            <div class="col-6 col-md-3">
              <div class="card card-statistic-1">
                <div class="card-icon bg-info"><i class="fas fa-redo"></i></div>
                <div class="card-wrap">
                  <div class="card-header"><h4>Has Paid Retry</h4></div>
                  <div class="card-body"><%= rows.filter(r => r.hasSuccessRetry).length %></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Legend -->
          <div class="mb-3">
            <span class="badge badge-warning mr-2">Has Paid Retry</span>
            User later retried and paid — they received data twice but only paid once.
            &nbsp;|&nbsp;
            <span class="badge badge-danger mr-2">No Paid Retry</span>
            User received data and was never charged at all.
          </div>

          <div class="card">
            <div class="card-header">
              <h4>Suspicious Failed Transactions</h4>
            </div>
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                  <thead>
                    <tr>
                      <th>Date</th>
                      <th>User</th>
                      <th>Phone</th>
                      <th class="text-right">Amount</th>
                      <th>Status</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (rows.length === 0) { %>
                      <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                          No suspicious transactions found.
                        </td>
                      </tr>
                    <% } %>
                    <% rows.forEach(function(tx) { %>
                      <tr id="row-<%= tx._id %>">
                        <td>
                          <small>
                            <%= new Date(tx.createdAt).toLocaleString('en-GB', {
                              day: '2-digit', month: 'short', year: 'numeric',
                              hour: '2-digit', minute: '2-digit'
                            }) %>
                          </small>
                        </td>
                        <td>
                          <strong><%= tx.user ? tx.user.username : '—' %></strong><br>
                          <small class="text-muted"><%= tx.user ? tx.user.email : '' %></small>
                        </td>
                        <td><code><%= tx.phone || '—' %></code></td>
                        <td class="text-right"><strong>₦<%= (tx.amount || 0).toLocaleString() %></strong></td>
                        <td>
                          <% if (tx.hasSuccessRetry) { %>
                            <span class="badge badge-warning">Has Paid Retry</span>
                          <% } else { %>
                            <span class="badge badge-danger">No Paid Retry</span>
                          <% } %>
                        </td>
                        <td>
                          <button
                            class="btn btn-sm btn-danger deduct-btn"
                            data-id="<%= tx._id %>"
                            data-amount="<%= tx.amount %>"
                            data-user="<%= tx.user ? tx.user.username : 'Unknown' %>"
                          >
                            Deduct Wallet
                          </button>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

        </div><!-- /section-body -->
      </section>
    </div>

    <%- include('../partials/footerAdmin.ejs') %>
  </div>
</div>
<script src="/admin/assets/js/app.min.js"></script>
<script src="/admin/assets/js/scripts.js"></script>
<script>
document.querySelectorAll('.deduct-btn').forEach(function (btn) {
  btn.addEventListener('click', async function () {
    const id     = this.dataset.id;
    const amount = Number(this.dataset.amount).toLocaleString();
    const user   = this.dataset.user;

    const confirmed = await Swal.fire({
      icon: 'warning',
      title: 'Confirm Deduction',
      html: `Deduct <strong>₦${amount}</strong> from <strong>${user}</strong>'s wallet?<br>
             <small class="text-muted">Only do this if you have confirmed data delivery in OurDataStore.</small>`,
      showCancelButton: true,
      confirmButtonText: 'Yes, Deduct',
      confirmButtonColor: '#dc3545',
    });

    if (!confirmed.isConfirmed) return;

    btn.disabled = true;
    btn.textContent = 'Working…';

    try {
      const res  = await fetch('/admin/damage-control/deduct', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>' },
        body: JSON.stringify({ transactionId: id }),
      });
      const data = await res.json();

      if (data.success) {
        Swal.fire({ icon: 'success', title: 'Done', text: data.message, timer: 2500, showConfirmButton: false });
        const row = document.getElementById('row-' + id);
        if (row) {
          row.style.opacity = '0.4';
          btn.textContent = 'Deducted';
          btn.classList.replace('btn-danger', 'btn-secondary');
        }
      } else {
        Swal.fire({ icon: 'error', title: 'Failed', text: data.message });
        btn.disabled = false;
        btn.textContent = 'Deduct Wallet';
      }
    } catch (_) {
      Swal.fire({ icon: 'error', text: 'Something went wrong' });
      btn.disabled = false;
      btn.textContent = 'Deduct Wallet';
    }
  });
});
</script>
